#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Course package commands over the existing LemmaSim raw device transport."""
import argparse
import json
from pathlib import Path


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='operation', required=True)
    for name in ('install', 'load', 'delete-probe'):
        command = commands.add_parser(name)
        command.add_argument('--session-dir', required=True, type=Path)
        command.add_argument('--cycle', type=int)
        if name == 'install':
            command.add_argument('--package', required=True, type=Path)
            command.add_argument('--transaction', required=True, type=int)
        else:
            command.add_argument('--identity', required=True, type=int)
            command.add_argument('--edition', required=True, type=int)
            command.add_argument('--crc', required=True, type=lambda s: int(s, 0))
            if name == 'load':
                command.add_argument('--node', required=True, type=int)
            else:
                command.add_argument('--transaction', required=True, type=int)
    args = parser.parse_args()
    args.command = 'course-'+args.operation
    metadata = json.loads((args.session_dir/'session.json').read_text())
    if metadata.get('backend') == 'qemu':
        from lemmasim_course_fast import send
    else:
        from lemmasim_course import send
    print(json.dumps(send(args), indent=2))


if __name__ == '__main__':
    main()
