  "objective": "Task009: physical implementation corrections and connected machine, school, operator and developer workflows; preserve inherited qualification obligations",
  "historical_checkpoint": "docs/plan/009-session-state.html",
  "resource_budgets": {
    "status": "Read-only Git/receipt inspection; each Git command at most 15 seconds; no build or execution",
    "host_export": "scripts/lean_export_host.py: two host Lean workers; 65536 KiB worker stack reservation",
    "ordinary_build": "Existing build entry points default to 300 seconds per bounded tool command",
    "kernel_fresh_qualification": "scripts/check_kernel.py: default full matrix has 2400-second whole deadline, QEMU default 90 seconds, one/two local row processes. CI uses two independent fixed O0/O2 producers, each one row process, deadline 2400s, tool 300s, QEMU 90s and cold private Lake per image; separate full collector revalidates exact 20/24/28/6. Do not combine host monotonic times into one elapsed claim.",
    "notebook_writing": "CI writing lane: 3500-second whole deadline; separate pinned QEMU build",
    "live_sessions": "Retain each session's original admission/budget receipt; do not restart or extend it from status",
    "incremental_notebook": "scripts/check_incremental_notebook.py: timeout300s per operation, boot30/action30 virtual seconds, whole deadline1200s; fresh instances and private media",
    "multimodal": "New converter guest component <=5M RTL cycles/120 host seconds per backend; controller corpus bounded separately; original inherited campaign limits retained",
    "school": "Hosted native one-authority process; max1MiB request/16MiB snapshot, default8MiB artifact,10000events,32queued/reserve4interactive/4leased; bounded actual worker/client/load checkers own declared limits"
  },
