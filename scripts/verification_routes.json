{
  "schema": "lemma-verification-routes/v1",
  "comparison_base": "8e75bc6541131189d7a2efe02e9ff77bde61194f",
  "objective": "Reliable incremental Lemma builds with validated artifact reuse and fresh affected behavior checks",
  "historical_checkpoint": "docs/plan/006-session-state.md",
  "resource_budgets": {
    "status": "Read-only Git/receipt inspection; each Git command at most 15 seconds; no build or execution",
    "host_export": "scripts/lean_export_host.py: two host Lean workers; 65536 KiB worker stack reservation",
    "ordinary_build": "Existing build entry points default to 300 seconds per bounded tool command",
    "kernel_fresh_qualification": "scripts/check_kernel.py: deadline at most 2400 seconds, QEMU timeout default 90 seconds",
    "notebook_writing": "CI writing lane: 3500-second whole deadline; separate pinned QEMU build",
    "live_sessions": "Retain each session's original admission/budget receipt; do not restart or extend it from status",
    "incremental_notebook": "scripts/check_incremental_notebook.py: timeout300s per operation, boot30/action30 virtual seconds, whole deadline1200s; fresh instances and private media"
  },
  "claims": {
    "cache-host": {
      "kind": "validation",
      "command": "python3 -m unittest discover -s tests/cache -v"
    },
    "metadata": {
      "kind": "validation",
      "command": "python3 scripts/check_scaffold.py && python3 -m unittest discover -s tests/scaffold -v"
    },
    "kernel-host": {
      "kind": "validation",
      "command": "nix develop --no-write-lock-file --command python3 -m unittest discover -s tests/kernel -v"
    },
    "core0-fresh": {
      "kind": "execution",
      "command": "nix develop --no-write-lock-file --command ./scripts/check-core0.sh --clean --work-dir build/core0/qualification-UNUSED"
    },
    "notebook-qemu": {
      "kind": "execution",
      "command": "nix develop --no-write-lock-file --command ./scripts/check-lemmasim.sh --clean --lane writing --with-o0 --work-dir build/lemmasim/writing-UNUSED --deadline 3500"
    },
    "rtl-devices": {
      "kind": "execution",
      "command": "python3 scripts/check_silicon.py --lane devices --work-dir build/silicon/devices-UNUSED --timeout 600 --jobs 2"
    },
    "rtl-notebook": {
      "kind": "execution",
      "command": "Select an unused output and run the source-bound canonical RTL notebook launcher/checker named in docs/plan/006-session-state.md; preserve original phase budgets"
    },
    "browser": {
      "kind": "execution",
      "command": "Run the affected actual browser input/packaging/persistence workflow from its retained admission plan; native results do not substitute"
    },
    "physical-flow": {
      "kind": "execution",
      "command": "Run the affected pinned physical-flow gate with exact source/tool identities; synthesis, routing, DRC/LVS and physical conformance stay separate"
    },
    "contract-review": {
      "kind": "validation",
      "command": "Inspect the changed contract and actual consumers; version semantics before selecting backend qualification"
    },
    "fresh-qualification-review": {
      "kind": "validation",
      "command": "Review required fresh, source-negative, optimization and backend coverage; keep independent compilation jobs fresh"
    },
    "dependency-review": {
      "kind": "validation",
      "command": "Classify unmatched changed paths and imported/generated dependencies in scripts/verification_routes.json before claiming coverage"
    },
    "incremental-canonical-qemu": {
      "kind": "execution",
      "command": "nix develop --no-write-lock-file --command python3 scripts/check_incremental_notebook.py --work-dir build/incremental/notebook-UNUSED --native-bundle NATIVE_BUNDLE --guest-build GUEST_BUILD --guest-source-root EXACT_SOURCE_ROOT --initial-medium ACKNOWLEDGED_EMPTY_MEDIUM"
    }
  },
