    p.add_argument('--fresh',action='store_true',help='Execute target/reset-ROM actions without cache reads; audits remain fresh')
    p.add_argument('--cache-dir',type=Path,help='Local validated action-cache directory')
    p=sub.add_parser('init');p.add_argument('--workload',choices=('initializer','parameterized-initializer'),default='initializer');p.add_argument('--native-bundle',type=Path);p.add_argument('--backend',choices=('qemu','rtl'),default='qemu');p.add_argument('--profile');p.add_argument('--disk',type=Path,required=True);p.add_argument('--size-mib',type=int,default=256);p.add_argument('--force',action='store_true');p.add_argument('--session-dir',type=Path);p.add_argument('--timeout',type=int,default=900);p.set_defaults(function=initialize)
    p=sub.add_parser('run');p.add_argument('--backend',choices=('qemu','rtl'),default='qemu');p.add_argument('--profile');p.add_argument('--workload',choices=('service','notebook','initializer','school-notebook','school-initializer','parameterized-notebook','parameterized-initializer','managed-notebook','managed-initializer','devices','power','ble','usb','usb-bulk-notebook','usb-bulk-initializer','usb-next-bulk-notebook','usb-next-bulk-initializer','usb-wire-bulk-notebook','usb-wire-bulk-initializer','usb-clocked-bulk-notebook','usb-clocked-bulk-initializer','usb-clocked-retry-bulk-notebook','usb-clocked-retry-bulk-initializer','usb-clocked-closure-retry-bulk-notebook','usb-clocked-closure-retry-bulk-initializer','usb-clocked-package-retry-bulk-notebook','usb-clocked-package-retry-bulk-initializer','usb-clocked-package-entry2-bulk-notebook','usb-clocked-package-entry2-bulk-initializer','usb-clocked-reader-entry2-bulk-notebook','usb-clocked-reader-entry2-bulk-initializer'));p.add_argument('--cycles',type=int,default=20000000);p.add_argument('--trace-limit',type=int,default=10000);p.add_argument('--uart-input',type=Path);p.add_argument('--events',type=Path);p.add_argument('--uart-stop');p.add_argument('--uart-stop-hex');p.add_argument('--stop-after-panel',type=int);p.add_argument('--fail-flush',type=int);p.add_argument('--observer-cycle',type=int);p.add_argument('--ram-dump',help='RTL only: external RAM address:bytes, at most 1MiB');p.add_argument('--block-trace',action='store_true',default=None,help='RTL only: first4096 literal block MMIO/DMA/media observations');p.add_argument('--disk',type=Path);p.add_argument('--mode',choices=('student','developer','laboratory'),default='student');p.add_argument('--record',type=Path);p.add_argument('--geometry');p.add_argument('--headless',action='store_true');p.add_argument('--raw-input',type=Path);p.add_argument('--fault',action='append');p.add_argument('--timeout',type=float);p.set_defaults(function=run)
    p=sub.add_parser('replay');p.add_argument('--backend',choices=('qemu','rtl'),default='qemu');p.add_argument('--session',type=Path,required=True);p.add_argument('--disk-copy',type=Path,required=True);p.add_argument('--timeout',type=float,default=120);p.set_defaults(function=replay)
    p=sub.add_parser('control');p.add_argument('--run-directory',type=Path,required=True);p.add_argument('action',choices=('inspect','pause','resume','reset','power-cut'));p.set_defaults(function=control)
    p=sub.add_parser('archive');g=p.add_mutually_exclusive_group(required=True);g.add_argument('--session',type=Path);g.add_argument('--acceptance',type=Path);p.add_argument('--to',type=Path,required=True);p.set_defaults(function=archive_session)
    p=sub.add_parser('copy');p.add_argument('--disk',type=Path,required=True);p.add_argument('--to',type=Path,required=True);p.set_defaults(function=copy_image)
    args=parser.parse_args()
    timeout_limit=3600
    if getattr(args,'backend','qemu')=='rtl':
        import silicon_guest
        timeout_limit=silicon_guest.MAX_RUN_SECONDS
    if getattr(args,'timeout',None) is not None and not 0<args.timeout<=timeout_limit:
        parser.error(f'timeout must be1..{timeout_limit} seconds')
    try:
        select_school_notebook_version(args)
        select_checkpoint_binding(args)
        if args.command in ('course-install','course-load','course-delete-probe'):
            import lemmasim_course
            print(json.dumps(lemmasim_course.send(args),indent=2))
            return 0
        if args.command in ('build','run') and getattr(args,'profile',None) in ('lemma-silicon-dev/0.5.0','lemma-silicon-dev/0.6.0','lemma-silicon-dev/0.8.0','lemma-silicon-dev/0.9.0','lemma-silicon-dev/0.10.0','lemma-silicon-dev/0.11.0','lemma-silicon-dev/0.13.0') and args.backend!='rtl':raise Failure('BLE binding5 requires the exact RTL backend')
        if args.command=='build' and args.rtl_source_root is not None and (args.backend!='rtl' or args.profile not in ('lemma-silicon-dev/0.6.0','lemma-silicon-dev/0.8.0','lemma-silicon-dev/0.11.0','lemma-silicon-dev/0.13.0') or args.rtl_build is None):raise Failure('--rtl-source-root requires USB6/8/11/13 RTL and an explicit --rtl-build')
        if args.command=='build' and args.guest_source_root is not None:
            frozen_usb=args.backend=='rtl' and args.profile in ('lemma-silicon-dev/0.6.0','lemma-silicon-dev/0.8.0','lemma-silicon-dev/0.11.0','lemma-silicon-dev/0.13.0')
            frozen_school=args.backend=='qemu' and args.profile=='lemma-silicon-dev/0.14.0' and args.workload in ('school-notebook','school-initializer')
            if args.guest_build is None or not (frozen_usb or frozen_school):raise Failure('--guest-source-root requires explicit audited USB RTL or School23/v2 Fast guest build')
        if args.command=='build' and getattr(args,'deps',None) is not None and args.backend!='rtl':raise Failure('--silicon-deps requires actual RTL preparation')
        if args.command=='build' and args.guest_bundle is not None and (args.backend!='qemu' or args.profile not in ('lemma-silicon-dev/0.3.0','lemma-silicon-dev/0.4.0') or args.guest_build is not None):raise Failure('--guest-bundle requires qualified canonical/Power QEMU and excludes --guest-build')
        if args.command=='native-bundle-build':
            import silicon_guest_bundle
            silicon_guest_bundle.bundle(args)
            return 0
        if args.command=='browser-build':
            if args.engine=='qemu-tci':
                if not args.reuse_wasm or args.guest_bundle is None or args.wasm_input_bundle is not None or args.wasm_source_bundle is not None or args.host_optimization!='scalar':
                    raise Failure('QEMU/TCI packaging requires --reuse-wasm, --wasm-build admitted-runtime and --guest-bundle; host compilation uses tooling/lemmasim/tci/build.py')
                import lemmasim_browser_tci
                lemmasim_browser_tci.bundle(args)
                return 0
            if args.wasm_input_bundle is not None and not args.reuse_wasm:
                raise Failure('--wasm-input-bundle requires --reuse-wasm')
            if args.reuse_wasm and (args.wasm_source_bundle is not None or args.host_optimization!='scalar'):
                raise Failure('Host compilation options require a fresh Wasm build')
            import lemmasim_browser
            (lemmasim_browser.bundle if args.reuse_wasm else lemmasim_browser.build)(args)
            return 0
        if args.command=='browser-serve':
            import lemmasim_browser
            lemmasim_browser.serve(args)
            return 0
        if args.command=='init' and (args.native_bundle is not None or args.backend=='rtl' or args.profile in ('lemma-silicon-dev/0.1.0','lemma-silicon-dev/0.2.0','lemma-silicon-dev/0.3.0','lemma-silicon-dev/0.4.0','lemma-silicon-dev/0.14.0')):
            import lemmasim_session
            lemmasim_session.initialize(args)
            return 0
        if args.command in ('session','session-control','snapshot','restore','session-replay','button'):
            import lemmasim_session
            if args.command=='session':
                if args.workload in ('usb-clocked-retry-bulk-notebook','usb-clocked-retry-bulk-initializer','usb-clocked-closure-retry-bulk-notebook','usb-clocked-closure-retry-bulk-initializer','usb-clocked-package-retry-bulk-notebook','usb-clocked-package-retry-bulk-initializer','usb-clocked-package-entry2-bulk-notebook','usb-clocked-package-entry2-bulk-initializer','usb-clocked-reader-entry2-bulk-notebook','usb-clocked-reader-entry2-bulk-initializer') and not args.usb_recovery:
                    raise Failure('Recovery guest workloads require the explicit --usb-recovery control contract')
                if args.profile in ('lemma-silicon-dev/0.5.0','lemma-silicon-dev/0.6.0','lemma-silicon-dev/0.8.0','lemma-silicon-dev/0.9.0','lemma-silicon-dev/0.10.0','lemma-silicon-dev/0.11.0','lemma-silicon-dev/0.13.0') and args.backend!='rtl':raise Failure('BLE binding5 requires the exact RTL backend')
                usb_options=(args.usb_host_prepared,args.usb_peer_directory,args.usb_peer_socket,args.usb_host_state)
                if args.usb_recovery:
                    if args.backend != 'rtl' or args.profile != 'lemma-silicon-dev/0.13.0' or args.mode not in ('developer','laboratory'):
                        raise Failure('USB recovery requires Clocked13 RTL Developer or Laboratory mode')
                    if args.restore is None and args.usb_host_prepared is None:
                        raise Failure('Live USB recovery requires exact policy4 and a persistent peer/outbox namespace')
                if any(x is not None for x in usb_options):
                    if args.backend!='rtl' or args.profile not in ('lemma-silicon-dev/0.6.0','lemma-silicon-dev/0.8.0','lemma-silicon-dev/0.11.0','lemma-silicon-dev/0.13.0') or args.workload not in ('usb','notebook','initializer','usb-bulk-notebook','usb-bulk-initializer','usb-next-bulk-notebook','usb-next-bulk-initializer','usb-wire-bulk-notebook','usb-wire-bulk-initializer','usb-clocked-bulk-notebook','usb-clocked-bulk-initializer','usb-clocked-retry-bulk-notebook','usb-clocked-retry-bulk-initializer','usb-clocked-closure-retry-bulk-notebook','usb-clocked-closure-retry-bulk-initializer','usb-clocked-package-retry-bulk-notebook','usb-clocked-package-retry-bulk-initializer','usb-clocked-package-entry2-bulk-notebook','usb-clocked-package-entry2-bulk-initializer','usb-clocked-reader-entry2-bulk-notebook','usb-clocked-reader-entry2-bulk-initializer') or args.mode not in ('developer','laboratory'):
                        raise Failure('USB packet host requires USB6/8/11/13 RTL probe, notebook or initializer in Developer or Laboratory mode')
                    if any(x is None for x in usb_options):raise Failure('USB packet host requires prepared host, peer directory/socket and retained host state')
                    if args.disk is not None or args.companion is not None or args.restore is not None:raise Failure('USB peer uses independent opaque medium and cold USB state')
                    lemmasim_session.bounded(args.usb_peer_timeout_ms,100,60000,'USB peer timeout milliseconds')
                if args.usb_replay is not None or (args.profile in ('lemma-silicon-dev/0.6.0','lemma-silicon-dev/0.8.0','lemma-silicon-dev/0.11.0','lemma-silicon-dev/0.13.0') and args.restore is not None):
                    if args.backend!='rtl' or args.profile not in ('lemma-silicon-dev/0.6.0','lemma-silicon-dev/0.8.0','lemma-silicon-dev/0.11.0','lemma-silicon-dev/0.13.0') or args.mode not in ('developer','laboratory') or args.restore is None:raise Failure('USB raw fork requires USB6/8/11/13 RTL --restore in Developer or Laboratory mode')
                    if any(x is not None for x in usb_options) or args.disk is not None or args.companion is not None:raise Failure('USB raw fork excludes live host, original medium and companion')
                if args.ble_peer is not None or args.ble_replay is not None or args.ble_peer_arg or args.ble_drop_packets:
                    if args.backend!='rtl' or args.profile!='lemma-silicon-dev/0.5.0' or args.mode not in ('developer','laboratory'):raise Failure('BLE manual peer/replay requires binding5 RTL in Developer or Laboratory mode')
                if args.ble_drop_packets and args.mode!='laboratory':raise Failure('Wire packet loss requires Laboratory mode')
                if args.ble_replay is not None and (not args.restore or args.ble_peer is not None):raise Failure('BLE replay requires an isolated --restore and excludes live peer')
                if args.rtl_source_root is not None and (args.backend!='rtl' or args.profile not in ('lemma-silicon-dev/0.6.0','lemma-silicon-dev/0.8.0','lemma-silicon-dev/0.11.0','lemma-silicon-dev/0.13.0') or args.native_bundle is not None):raise Failure('--rtl-source-root requires USB6/8/11/13 RTL and excludes --native-bundle')
                if args.guest_source_root is not None:
                    usb_archive=(args.backend=='rtl' and args.profile in ('lemma-silicon-dev/0.6.0','lemma-silicon-dev/0.8.0','lemma-silicon-dev/0.11.0','lemma-silicon-dev/0.13.0') and args.native_bundle is None)
                    lab_archive=(args.profile=='lemma-silicon-dev/0.3.0' and args.mode=='laboratory' and args.workload=='notebook' and args.native_bundle is not None and args.guest_build is not None)
                    course_archive=False
                    if (args.profile=='lemma-silicon-dev/0.3.0' and args.mode in ('developer','laboratory') and
                            args.workload in ('notebook','initializer') and args.native_bundle is not None and args.guest_build is not None):
                        from silicon_guest_bundle import COURSE_CONFIGURATIONS, COURSE_AWAIT_CONFIGURATIONS
                        course_archive=json.loads((args.guest_build/'build.json').read_text()).get('configuration') in (COURSE_CONFIGURATIONS[args.workload],COURSE_AWAIT_CONFIGURATIONS[args.workload])
                    if not (usb_archive or lab_archive or course_archive):raise Failure('--guest-source-root requires USB6/8/11/13 RTL preparation, an exact canonical course guest, or a canonical Laboratory Array/String OOM native-bundle override')
                if args.guest_build is not None and args.native_bundle is None:raise Failure('--guest-build session override requires --native-bundle')
                if args.profile not in (None,'lemma-silicon-dev/0.1.0','lemma-silicon-dev/0.2.0','lemma-silicon-dev/0.3.0','lemma-silicon-dev/0.4.0','lemma-silicon-dev/0.5.0','lemma-silicon-dev/0.6.0','lemma-silicon-dev/0.8.0','lemma-silicon-dev/0.11.0','lemma-silicon-dev/0.13.0','lemma-silicon-dev/0.14.0'):raise Failure('Persistent session requires the declared silicon-development binding')
                lemmasim_session.bounded(args.quantum,1,1000000,'Quantum')
                lemmasim_session.bounded(args.trace_limit,0,1000000,'Trace limit')
                lemmasim_session.bounded(args.memory_latency,0,1024,'Memory latency')
                if args.backing_replay is not None and args.restore is None:raise Failure('Backing outcome replay requires an isolated --restore')
                if args.companion is not None:
                    if args.disk is not None or args.restore is not None or args.backing_replay is not None:raise Failure('Companion backing requires a cold machine without local --disk, --restore or --backing-replay')
                    if any(value is None for value in (args.companion_prepared,args.companion_socket,args.companion_state)):raise Failure('Companion backing requires --companion-prepared, --companion-socket and durable --companion-state')
                elif any(value is not None for value in (args.companion_prepared,args.companion_socket,args.companion_state)):raise Failure('Companion options require --companion DIRECTORY')
                if args.fail_flush is not None:
                    if args.mode != 'laboratory':raise Failure('Failed-FLUSH injection requires Laboratory mode')
                    lemmasim_session.bounded(args.fail_flush,1,1000000,'Failed-FLUSH ordinal')
                lemmasim_session.serve(args)
            else:
                if args.command=='session-control':value=json.loads(args.request)
                elif args.command=='button':
                    value={'action':'inject','kind':'button','level':args.level}
                    if args.cycle is not None:value['cycle']=args.cycle
                elif args.command=='session-replay':value={'action':'replay','snapshot':str(args.snapshot.resolve()),'capture':str(args.capture.resolve()),'until_cycle':args.until_cycle,'until_ns':args.until_ns}
                else:value={'action':args.command,'path':str(args.path.resolve())}
                print(json.dumps(lemmasim_session.request(args.session_dir,value),indent=2))
            return 0
        if getattr(args,'backend','qemu')=='rtl':
            import silicon_guest
            if getattr(args,'profile',None) not in (None,'lemma-silicon-dev/0.1.0','lemma-silicon-dev/0.2.0','lemma-silicon-dev/0.3.0','lemma-silicon-dev/0.4.0','lemma-silicon-dev/0.5.0','lemma-silicon-dev/0.6.0','lemma-silicon-dev/0.8.0','lemma-silicon-dev/0.11.0','lemma-silicon-dev/0.13.0','lemma-silicon-dev/0.14.0'):raise Failure('RTL backend requires a supported silicon-development profile')
            if args.command=='build':silicon_guest.build(args)
            elif args.command=='run':silicon_guest.run(args)
            elif args.command=='replay':silicon_guest.replay(args)
            else:raise Failure('Unsupported RTL command')
        elif getattr(args,'profile',None) in ('lemma-silicon-dev/0.1.0','lemma-silicon-dev/0.2.0','lemma-silicon-dev/0.3.0','lemma-silicon-dev/0.4.0','lemma-silicon-dev/0.14.0'):
            import lemmasim_fast
            if args.command != 'build':raise Failure('Matched fast binding uses the persistent session command; batch run/replay is not yet admitted')
            if args.rtl_build is not None:raise Failure('--rtl-build requires the RTL backend')
            lemmasim_fast.build(args)
        else:
            if any(getattr(args,key,None) is not None for key in ('guest_build','rtl_build')):raise Failure('RTL prepared artifact options require --backend rtl')
            if getattr(args,'profile',None) not in (None,'lemmasim-virt/0.1.0'):raise Failure('QEMU backend requires profile lemmasim-virt/0.1.0')
            if args.command!='init' and getattr(args,'workload',None) not in (None,'notebook'):raise Failure('QEMU native launcher supports notebook workload')
            if args.command=='run':
                if any(getattr(args,key,None) is not None for key in ('uart_input','events','uart_stop','uart_stop_hex','stop_after_panel','fail_flush','observer_cycle','ram_dump','block_trace')):raise Failure('RTL transport options require --backend rtl')
                args.geometry=args.geometry or '1650x2200'
            if args.command=='run' and args.disk is None:raise Failure('QEMU notebook requires --disk')
            args.function(args)
        return 0
    except (Failure,RuntimeError,OSError,ValueError,KeyError,subprocess.TimeoutExpired) as error:print(f'FAIL: {error}',file=sys.stderr);return 1
if __name__=='__main__':raise SystemExit(main())
