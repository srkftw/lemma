import Lemma.User.Runtime.Arena

/-! Real bounded closure/environment graph storage. Scalar captures are owned
full64 boxes. Source-derived application dispatch is generated by ManagedClosureIR;
this runtime stores/validates roots and implements their actual lifetime. -/
namespace Lemma.User.Runtime.ManagedClosure
open Lemma.Core0.Memory Lemma.User.Runtime Lemma.User

def cookie : UInt64 := 0x31534c4341524d4c
def maximumCaptures : UInt64 := 4
def maximumTargets : UInt64 := 8

private def address (handle : UInt64) : UInt64 :=
  Arena.page + 128 + (handle &&& 31) * 128

/-- Cleanup has the same cancellation-independent authority as Arena.release.
Every header field relevant to an object access is checked before returning its
address; source values never supply raw addresses to this helper. -/
private def rawObject (handle tag length : UInt64) : Action :=
  .bind (Memory.read64 Arena.control) fun s phase => if s = 0 then
  if phase = 1 then
  .bind (Memory.read64 Arena.page) fun s magic => if s = 0 then
  if magic = 0x31414e4552414d4c then
  .bind (Memory.read64 (Arena.page + 8)) fun s version => if s = 0 then
  if version = 1 then
  .bind (Memory.read64 (Arena.control + 16)) fun s count => if s = 0 then
  if count = 0 then .done Arena.lifetime 0 else
  if Arena.capacity < count then .done Arena.lifetime 0 else
  let slot := handle &&& 31
  let generation := handle >>> 5
  if generation = 0 then .done Arena.invalid 0 else
  if Arena.maximumGeneration < generation then .done Arena.invalid 0 else
  if Arena.capacity ≤ slot then .done Arena.invalid 0 else
  let location := address handle
  .bind (Memory.read64 location) fun s state => if s = 0 then
  if state = 1 then
  .bind (Memory.read64 (location + 8)) fun s actualGeneration => if s = 0 then
  if actualGeneration = generation then
  .bind (Memory.read64 (location + 16)) fun s references => if s = 0 then
  if references = 0 then .done Arena.lifetime 0 else
  if 65535 < references then .done Arena.lifetime 0 else
  .bind (Memory.read64 (location + 24)) fun s actualTag => if s = 0 then
  .bind (Memory.read64 (location + 32)) fun s actualLength => if s = 0 then
  if actualTag = tag then if actualLength = length then .done 0 location
  else .done Arena.invalid 0 else .done Arena.invalid 0
  else .done s 0 else .done s 0 else .done s 0 else .done Arena.invalid 0
  else .done s 0 else .done Arena.invalid 0 else .done s 0
  else .done s 0
  else .done Arena.lifetime 0 else .done s 0
  else .done Arena.lifetime 0 else .done s 0
  else .done Arena.lifetime 0 else .done s 0

private def rawCount (handle : UInt64) : Action :=
  .bind (rawObject handle Arena.bytesTag 64) fun s location => if s = 0 then
  .bind (Memory.read64 (location+64)) fun s actual => if s = 0 then
  if actual = cookie then
  .bind (Memory.read64 (location+72)) fun s code => if s = 0 then
  if code = 0 then .done Arena.invalid 0 else
  if maximumTargets < code then .done Arena.invalid 0 else
  .bind (Memory.read64 (location+120)) fun s reserved => if s = 0 then
  if reserved = 0 then
  .bind (Memory.read64 (location+80)) fun s count => if s = 0 then
  if count ≤ maximumCaptures then .done 0 count else .done Arena.invalid 0
  else .done s 0 else .done Arena.invalid 0 else .done s 0
  else .done s 0 else .done Arena.invalid 0 else .done s 0 else .done s 0

private def validateStep (i _ : UInt32) (acc handle count _ _ : UInt64) : Action :=
  .bind (Memory.read64 (address handle+88+i.toUInt64*8)) fun s child => if s = 0 then
  if i.toUInt64 < count then
    .bind (rawObject child Arena.boxTag 8) fun s _ => .done s acc
  else if child = 0 then .done 0 acc else .done Arena.invalid 0
  else .done s 0

private def releaseStep (i _ : UInt32) (first handle count _ _ : UInt64) : Action :=
  if i.toUInt64 < count then
  .bind (Memory.read64 (address handle+88+i.toUInt64*8)) fun s child =>
  if s = 0 then .bind (Arena.release child) fun s _ => .done 0 (if first = 0 then s.toUInt64 else first)
  else .done 0 (if first = 0 then s.toUInt64 else first)
  else .done 0 first

def release (handle : UInt64) : Action :=
  .bind (rawCount handle) fun s count => if s = 0 then
  .boundedFoldU64 4 validateStep 4 0 handle count 0 0 fun s _ => if s = 0 then
  .bind (Memory.read64 (address handle+16)) fun s references => if s = 0 then
  if 1 < references then Arena.release handle else
  .boundedFoldU64 4 releaseStep 4 0 handle count 0 0 fun s first => if s = 0 then
  if first = 0 then Arena.release handle else .done first.toUInt8 0
  else .done s 0 else .done s 0 else .done s 0 else .done s 0

private def valid (handle : UInt64) : Action :=
  .bind (Arena.bytesLength handle) fun s bytes => if s = 0 then
  if bytes = 64 then
  .bind (rawCount handle) fun s count => if s = 0 then
  .boundedFoldU64 4 validateStep 4 0 handle count 0 0 fun s _ => .done s count
  else .done s 0 else .done Arena.invalid 0 else .done s 0

def retain (handle : UInt64) : Action :=
  .bind (valid handle) fun s _ => if s = 0 then Arena.retain handle else .done s 0

def code (handle : UInt64) : Action :=
  .bind (valid handle) fun s _ => if s = 0 then Arena.bytesReadWord handle 8 else .done s 0

def arity (handle : UInt64) : Action := valid handle

/-- Capture access borrows its real box from a live graph and returns all64 bits. -/
def capture (handle index : UInt64) : Action :=
  .bind (valid handle) fun s count => if s = 0 then
  if index < count then
  .bind (Arena.bytesReadWord handle (24+index*8)) fun s child => if s = 0 then
  Arena.boxGet child else .done s 0 else .done Arena.invalid 0 else .done s 0

def box (value : UInt64) : Action :=
  .bind Arena.ensure fun s _ => if s = 0 then Arena.newBox value else .done s 0

def unbox (handle : UInt64) : Action := Arena.boxGet handle

private def cleanInputs (status : UInt8) (count c0 c1 c2 c3 : UInt64) : Action :=
  if 0 < count then .bind (Arena.release c0) fun _ _ =>
    if 1 < count then .bind (Arena.release c1) fun _ _ =>
      if 2 < count then .bind (Arena.release c2) fun _ _ =>
        if 3 < count then .bind (Arena.release c3) fun _ _ => .done status 0
        else .done status 0
      else .done status 0
    else .done status 0
  else .done status 0

private def writeObject (handle code count c0 c1 c2 c3 : UInt64) : Action :=
  .bind (Arena.bytesWriteWord handle 0 cookie) fun s _ => if s = 0 then
  .bind (Arena.bytesWriteWord handle 8 code) fun s _ => if s = 0 then
  .bind (Arena.bytesWriteWord handle 16 count) fun s _ => if s = 0 then
  .bind (Arena.bytesWriteWord handle 24 c0) fun s _ => if s = 0 then
  .bind (Arena.bytesWriteWord handle 32 c1) fun s _ => if s = 0 then
  .bind (Arena.bytesWriteWord handle 40 c2) fun s _ => if s = 0 then
  .bind (Arena.bytesWriteWord handle 48 c3) fun s _ => .done s handle
  else .done s 0 else .done s 0 else .done s 0 else .done s 0 else .done s 0 else .done s 0

/-- Each actual PAP consumes its owned capture roots, including on OOM.
All inputs are preflighted before allocating the closure/environment object.
The final reserved word remains zero from the real Arena.newBytes initialization. -/
def create (code count c0 c1 c2 c3 : UInt64) : Action :=
  if maximumCaptures < count then cleanInputs Arena.invalid count c0 c1 c2 c3 else
  if code = 0 then cleanInputs Arena.invalid count c0 c1 c2 c3 else
  if maximumTargets < code then cleanInputs Arena.invalid count c0 c1 c2 c3 else
  .bind Arena.ensure fun s _ => if s = 0 then
  .bind (if 0 < count then Arena.boxGet c0 else .done (if c0 = 0 then 0 else Arena.invalid) 0) fun s _ => if s = 0 then
  .bind (if 1 < count then Arena.boxGet c1 else .done (if c1 = 0 then 0 else Arena.invalid) 0) fun s _ => if s = 0 then
  .bind (if 2 < count then Arena.boxGet c2 else .done (if c2 = 0 then 0 else Arena.invalid) 0) fun s _ => if s = 0 then
  .bind (if 3 < count then Arena.boxGet c3 else .done (if c3 = 0 then 0 else Arena.invalid) 0) fun s _ => if s = 0 then
  .bind (Arena.newBytes 64) fun s handle => if s = 0 then
  .bind (writeObject handle code count c0 c1 c2 c3) fun s _ =>
  if s = 0 then .done 0 handle else
    .bind (Arena.release handle) fun _ _ => cleanInputs s count c0 c1 c2 c3
  else cleanInputs s count c0 c1 c2 c3
  else cleanInputs s count c0 c1 c2 c3 else cleanInputs s count c0 c1 c2 c3
  else cleanInputs s count c0 c1 c2 c3 else cleanInputs s count c0 c1 c2 c3
  else cleanInputs s count c0 c1 c2 c3

/-- Application owns one closure and one argument box. Reclaim them before
allocating the actual full64 result box. Shared closures preserve their captures.
Errors publish no result and cleanup is cancellation-independent. -/
def finish (handle argument value : UInt64) : Action :=
  .bind (release handle) fun s _ =>
  .bind (Arena.release argument) fun t _ =>
  if s = 0 then if t = 0 then box value else .done t 0 else .done s 0

def abort (handle argument status : UInt64) : Action :=
  .bind (release handle) fun _ _ =>
  .bind (Arena.release argument) fun _ _ => .done status.toUInt8 0

end Lemma.User.Runtime.ManagedClosure
